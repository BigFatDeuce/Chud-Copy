{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chud Copy",
  "version": "1.8.3",
  "identifier": "app.chudcopy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Chud Copy",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "backgroundColor": "#05060d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "rpm", "deb"],
    "category": "Utility",
    "shortDescription": "Copie et synchronisation manuelles de dossiers",
    "longDescription": "Chud Copy prépare, enregistre et exécute vos opérations de copie et de synchronisation entre dossiers et disques, uniquement quand vous le décidez.",
    "copyright": "Chud Copy, GPL-3.0-or-later. Moteur rclone, licence MIT.",
    "externalBin": ["binaries/rclone"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../licenses/": "licenses/" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "Spanish", "Arabic", "French", "PortugueseBR", "Russian"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "rpm": { "depends": ["webkit2gtk4.1", "gtk3"] },
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
